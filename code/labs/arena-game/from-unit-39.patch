@@ -0,0 +1,37 @@
+package main
+
+import "core:fmt"
+import "core:os"
+import "../score"
+import "../sim"
+
+main :: proc() {
+    if len(os.args) == 1 {
+        arena := sim.replay(7, 600)
+        fmt.printf("ticks=%d points=%d remaining=%d phase=%v\n", arena.ticks, arena.points, arena.count, arena.phase)
+        return
+    }
+    if len(os.args) == 2 && os.args[1] == "profile" {
+        total: u64
+        for seed in 1..=10_000 {
+            arena := sim.replay(u32(seed), 600)
+            total += u64(arena.ticks) + u64(arena.points)
+        }
+        fmt.println("digest:", total)
+        return
+    }
+    if len(os.args) == 2 && os.args[1] == "score-smoke" {
+        best, result := score.load("arena.score")
+        fmt.println("read:", result, best)
+        if result == .Invalid || result == .IO_Error {
+            os.exit(1)
+        }
+        if !score.save("arena.score", "arena.score.tmp", max(best, 12)) {
+            fmt.eprintln("Could not save score")
+            os.exit(1)
+        }
+        return
+    }
+    fmt.eprintln("Usage: arena-headless [score-smoke|profile]")
+    os.exit(2)
+}
diff --git a/score/score.odin b/score/score.odin
new file mode 100644
index 0000000..03b0567
--- /dev/null
+++ b/score/score.odin
@@ -0,0 +1,54 @@
+package score
+
+import "core:os"
+
+Read_Result :: enum { Valid, Missing, Invalid, IO_Error }
+
+encode :: proc(points: u32) -> [8]byte {
+    return {'A', 'R', '1', 0, byte(points), byte(points >> 8), byte(points >> 16), byte(points >> 24)}
+}
+
+decode :: proc(data: []byte) -> (u32, bool) {
+    if len(data) != 8 || data[0] != 'A' || data[1] != 'R' || data[2] != '1' || data[3] != 0 {
+        return 0, false
+    }
+    return u32(data[4]) | (u32(data[5]) << 8) | (u32(data[6]) << 16) | (u32(data[7]) << 24), true
+}
+
+load :: proc(path: string) -> (u32, Read_Result) {
+    file, err := os.open(path)
+    if err == .Not_Exist { return 0, .Missing }
+    if err != nil       { return 0, .IO_Error }
+    defer os.close(file)
+
+    buffer: [9]byte
+    used := 0
+    for used < len(buffer) {
+        read, read_error := os.read(file, buffer[used:])
+        used += read
+        if read_error == .EOF { break }
+        if read_error != nil    { return 0, .IO_Error }
+        if read == 0           { break }
+    }
+    points, ok := decode(buffer[:used])
+    if !ok { return 0, .Invalid }
+    return points, .Valid
+}
+
+save :: proc(path, temporary: string, points: u32) -> bool {
+    bytes := encode(points)
+    file, err := os.create(temporary)
+    if err != nil { return false }
+
+    written, write_error := os.write(file, bytes[:])
+    close_error := os.close(file)
+    if write_error != nil || close_error != nil || written != len(bytes) {
+        _ = os.remove(temporary)
+        return false
+    }
+    if os.rename(temporary, path) != nil {
+        _ = os.remove(temporary)
+        return false
+    }
+    return true
+}
diff --git a/score/score_test.odin b/score/score_test.odin
new file mode 100644
index 0000000..20af09a
--- /dev/null
+++ b/score/score_test.odin
@@ -0,0 +1,16 @@
+package score
+
+import "core:testing"
+
+@(test)
+bytes_are_versioned :: proc(t: ^testing.T) {
+    sample := encode(0x01020304)
+    testing.expect(t, sample == [8]byte{'A', 'R', '1', 0, 4, 3, 2, 1})
+    result, ok := decode(sample[:])
+    testing.expect(t, ok && result == 0x01020304)
+    _, truncated := decode(sample[:7])
+    testing.expect(t, !truncated)
+    sample[2] = '2'
+    _, future := decode(sample[:])
+    testing.expect(t, !future)
+}
