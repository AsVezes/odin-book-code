+control :: proc(arena: ^Arena, input: Input, restart_seed: u32) {
+    switch arena.phase {
+    case .Title, .Finished:
+        if input.start {
+            arena^ = new_arena(restart_seed)
+            arena.phase = .Playing
+        }
+    case .Playing:
+        if input.pause {
+            arena.phase = .Paused
+        }
+    case .Paused:
+        if input.pause {
+            arena.phase = .Playing
+        }
+    }
+}
